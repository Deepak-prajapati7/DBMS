{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "CAPSTONE/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
